{
  "name": "peicd100_pi",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "description": "PEICD100 Pi 工具箱：長對話／群組顯示、Goal／Progress、Usage、ACM、Notify、Theme、Activity 與 Suffix、防大災難 Guard，單一安裝與更新",
  "license": "UNLICENSED",
  "keywords": [
    "pi-package",
    "pi-extension",
    "acm",
    "webhook",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/peicd100/peicd100_pi.git"
  },
  "homepage": "https://github.com/peicd100/peicd100_pi#readme",
  "bugs": {
    "url": "https://github.com/peicd100/peicd100_pi/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "modules/",
    "src/",
    "scripts/migrate.mjs",
    "scripts/ref-query.mjs",
    "scripts/reference-parser.mjs",
    "scripts/acm-shadow.mjs",
    "MODULES.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "docs/"
  ],
  "pi": {
    "extensions": [
      "./extensions/acm.ts",
      "./extensions/webhook.ts",
      "./extensions/theme.ts",
      "./extensions/activity.ts",
      "./extensions/suffix.ts",
      "./extensions/goal.ts",
      "./extensions/progress.ts",
      "./extensions/focus.ts",
      "./extensions/usage.ts",
      "./extensions/guard.ts"
    ],
    "themes": [
      "./modules/theme/themes/pi-theme-docker-look.json"
    ],
    "skills": [],
    "prompts": []
  },
  "dependencies": {
    "@silvia-odwyer/photon-node": "0.3.4",
    "gpt-tokenizer": "3.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@narumitw/pi-goal": "0.54.11"
  },
  "scripts": {
    "test": "node --import ./tests/helpers/full-host-import-hook.mjs --test --test-concurrency=4 modules/acm/tests/*.test.mjs modules/webhook/tests/*.test.mjs modules/theme/tests/*.test.mjs modules/activity/tests/*.test.mjs modules/guard/tests/*.test.mjs tests/*.test.mjs",
    "test:target": "node --import ./tests/helpers/full-host-import-hook.mjs --test --test-concurrency=4 tests/*.test.mjs",
    "test:pi120": "node scripts/test-sdk120.mjs",
    "test:pi150": "node scripts/test-sdk150.mjs",
    "test:pi152": "node scripts/test-sdk152.mjs",
    "check:manifest": "node scripts/refresh-runtime-manifest.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:install": "node scripts/test-install.mjs",
    "test:remote": "node scripts/test-install.mjs --remote",
    "migrate": "node scripts/migrate.mjs",
    "refs": "node scripts/ref-query.mjs",
    "acm:shadow": "node scripts/acm-shadow.mjs"
  }
}
